# SiteBrain AI — Backend Example Configuration
# Copy this file to .env and replace the values for your environment.

# Required: OpenAI API Key for generating AI responses
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Database connection string
# Defaults to sqlite:///./sitebrain.db if not provided
DATABASE_URL=sqlite:///./sitebrain.db
